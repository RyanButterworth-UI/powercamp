# Neon Postgres connection string (find it in your Neon project → Connection Details).
# Format: postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# The active camp year — controls which year new registrations are tagged with.
CAMP_YEAR=2026

# Google Sheets API config (we write directly to the sheet via a service account).
# 1. Google Cloud Console: enable Sheets API, create a service account, download a JSON key.
# 2. Share the target spreadsheet with the service account email (Editor access).
# 3. The sheet ID comes from the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the entire private key with \n escapes preserved, wrapped in double quotes:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Magic-link signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# Admin password (bcrypt-hashed). Generate the hash with:
#   npm run hash:admin-password -- <yourPlainPassword>
# Then paste the resulting hash here (no quotes).
ADMIN_PASSWORD_HASH=

# Leader-application password (bcrypt-hashed). Same pattern as the admin
# hash above — anyone wanting to apply as a leader needs this password.
# Generate with: npm run hash:admin-password -- <yourLeaderPassword>
LEADER_PASSWORD_HASH=

# Gmail SMTP credentials for sending magic-link emails.
# 1. Turn on 2-Step Verification on the powercamplife@gmail.com account.
# 2. https://myaccount.google.com/apppasswords → generate an app password (no spaces).
GMAIL_USER=powercamplife@gmail.com
GMAIL_APP_PASSWORD=

# Display name shown as the From: in outbound emails.
FROM_NAME=Power Camp

# Where waiting-list requests are sent, and the address families are told to
# email to join the waiting list once registrations are closed. Optional —
# defaults to powercamplife@gmail.com if unset.
REGISTRATION_ADMIN_EMAIL=powercamplife@gmail.com

# Public URL of the Angular app — magic-link URLs are built off this.
# Local dev: http://localhost:4200. Production: https://register.powercamplife.co.za (or wherever).
APP_BASE_URL=http://localhost:4200

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:4200,https://powercamp-registration.onrender.com

# Server port (Render sets this automatically; leave default for local dev).
PORT=3000
